{
  "name": "brightcove/api",
  "description": "Brightcove PHP API Wrapper",
  "keywords": ["brightcove","api"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tamás Demeter-Haludka",
      "homepage": "https://github.com/tamasd"
    },
    {
      "name": "KonczGabor",
      "homepage": "https://github.com/KonczGabor"
    },
    {
      "name": "janmashat",
      "homepage": "https://github.com/janmashat"
    },
    {
      "name": "Tamás Nagy",
      "homepage": "https://github.com/ycecube"
    }
  ],
  "require": {
    "ext-curl": "*",
    "ext-json": "*",
    "php": ">=8.3",
    "php-http/client-common": "^2.7",
    "php-http/discovery": "^1.20"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.2"
  },
  "autoload": {
    "psr-4": {
      "Brightcove\\": "lib/Brightcove/",
      "Brightcove\\Test\\": "test/Brightcove/Test/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
